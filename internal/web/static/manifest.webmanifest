{
	"name": "Treckrr — Maschinenabrechnung",
	"short_name": "Treckrr",
	"description": "Abrechnung von Traktor- und Maschinenkosten pro Nachbar und Jahr.",
	"lang": "de",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "any",
	"background_color": "#edf1ec",
	"theme_color": "#1f2823",
	"icons": [
		{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/static/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"share_target": {
		"action": "/share-target",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": { "files": [{ "name": "photos", "accept": ["image/jpeg", "image/png", "image/gif", ".jpg", ".jpeg", ".png", ".gif"] }] }
	},
	"shortcuts": [
		{ "name": "Neue Buchung", "short_name": "Buchen", "description": "Nachbarn des laufenden Jahres zum Buchen öffnen", "url": "/#nachbarn",
			"icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
		{ "name": "Buchungen & Filter", "short_name": "Buchungen", "description": "Alle Buchungen des Jahres durchsuchen", "url": "/buchungen",
			"icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
		{ "name": "Offene Posten", "short_name": "Offen", "description": "Überfällige Beträge und Mahnwesen", "url": "/mahnwesen",
			"icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
	]
}

.git
.github
.gitignore
.dockerignore
*.md
!README.md
.env
.env.local
.env.example
/pgdata/
/data/
/exports/
*.log
*.xlsx
.idea/
.vscode/
# Project-local agent configuration and linked memory never belong in images.
/.agents/
/.claude/
/.impeccable/
/graphify-out/
Dockerfile
docker-compose.yml
docker-compose.ghcr.yml
compose.rotate-key.yml

# Node/Playwright E2E suite: CI-only, never part of the Go image build context.
# node_modules also carries symlinks (e.g. .bin/*) that break the context transfer.
node_modules/
/e2e/

# Local backup artifacts: never part of the image build context. They are
# encrypted today, but an unencrypted dump dropped here would otherwise land in a
# build-stage layer via `COPY . .` and sit in the build cache.
/backups/

# Local visual comparisons, test fixtures and screenshots are not application code.
/tmp/
/temp/
